# ZhanFinance Telegram Bot Configuration

# 1. Telegram Bot Token from @BotFather (e.g. 1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TELEGRAM_BOT_TOKEN=

# 2. Telegram Bot Username (without @, e.g. zhan_finance_bot)
TELEGRAM_BOT_USERNAME=zhan_finance_bot

# 3. Main JF-1C Backend API URL
JF_BACKEND_BASE_URL=http://localhost:8080/api

# 4. Internal shared secret token between main backend and tgbot microservice
INTERNAL_BOT_TOKEN=secret_internal_bot_token_change_in_production
